        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman Reporter\", \"email\": \"reporter-{{runId}}@example.com\", \"password\": \"Postman-Test-Password-123!\"}",
          "options": {
            "raw": {
              "language": "json"
