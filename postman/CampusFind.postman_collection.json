            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"reporter-{{runId}}@example.com\", \"password\": \"Postman-Test-Password-123!\"}",
          "options": {
