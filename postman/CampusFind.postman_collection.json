              "pm.environment.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Register claimant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman Claimant\", \"email\": \"claimant-{{runId}}@example.com\", \"password\": \"Postman-Test-Password-123!\"}",
          "options": {
            "raw": {
              "language": "json"
