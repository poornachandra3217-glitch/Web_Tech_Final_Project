            ]
          }
        }
      ]
    },
    {
      "name": "14 Another user cannot update listing",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"closed\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
