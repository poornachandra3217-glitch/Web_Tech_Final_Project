        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman blue backpack\", \"description\": \"A blue canvas backpack with a stitched orange pocket.\", \"category\": \"Bags\", \"location\": \"Library\", \"date\": \"2099-01-01\", \"type\": \"found\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Create found listing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman blue backpack\", \"description\": \"A blue canvas backpack with a stitched orange pocket.\", \"category\": \"Bags\", \"location\": \"Library\", \"date\": \"2026-01-01\", \"type\": \"found\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"itemId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Retrieve item",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Owner email stays private\",()=>pm.expect(pm.response.json().owner.email).to.eql(undefined));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Search and filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items?q=Postman&category=Bags&type=found&location=Library"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created item found\",()=>pm.expect(pm.response.json().items.some(x=>x._id===pm.environment.get(\"itemId\"))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Update item",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman verified blue backpack\", \"description\": \"A blue canvas backpack with a stitched orange pocket.\", \"category\": \"Bags\", \"location\": \"Library\", \"date\": \"2026-01-01\", \"type\": \"found\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Self claim rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}/claims",
        "body": {
          "mode": "raw",
          "raw": "{\"evidence\": \"These details belong to my own report.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
