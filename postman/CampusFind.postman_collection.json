{
  "info": {
    "name": "CampusFind API acceptance tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run sequentially against a test database. Creates two test users and one item per run; keeps recovery history. Uses cookie sessions and CSRF tokens. Do not run repeatedly on your production database."
  },
  "item": [
    {
      "name": "01 Start session and get CSRF token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"csrfToken\", pm.response.json().csrfToken); pm.environment.set(\"runId\", Date.now().toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Protected report rejects anonymous access",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Invalid registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Test\", \"email\": \"invalid\", \"password\": \"short\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Register reporter",
